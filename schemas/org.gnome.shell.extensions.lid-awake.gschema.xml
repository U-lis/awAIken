<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.lid-awake"
          path="/org/gnome/shell/extensions/lid-awake/">
    <key name="active" type="b">
      <default>false</default>
      <summary>깨어 있기 활성 상태</summary>
    </key>
    <key name="toggle-shortcut" type="as">
      <default><![CDATA[['<Super><Shift>l']]]></default>
      <summary>깨어 있기 토글 단축키</summary>
    </key>
    <key name="lock-on-lid-close" type="b">
      <default>true</default>
      <summary>덮개를 닫으면 화면을 끄면서 잠금</summary>
    </key>
    <key name="low-battery-threshold" type="i">
      <default>20</default>
      <range min="0" max="50"/>
      <summary>깨어 있기 중 배터리가 이 비율(%) 미만이면 강제 절전, 0 이면 사용 안 함</summary>
    </key>
    <key name="saved-state" type="s">
      <default>'{}'</default>
      <summary>원래 전원 설정 백업(JSON)</summary>
    </key>
  </schema>
</schemalist>
